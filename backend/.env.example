APP_NAME=MediKiosk API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://medikiosk:CHANGE_ME@postgres:5432/medikiosk
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
STAFF_TOKEN_EXPIRE_MINUTES=480
KIOSK_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_ADMIN_EMAIL=admin@medikiosk.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_BEFORE_USE
