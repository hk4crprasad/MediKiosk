APP_NAME=MediKiosk API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://medikiosk:REPLACE_POSTGRES_PASSWORD@postgres:5432/medikiosk
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
STAFF_TOKEN_EXPIRE_MINUTES=480
KIOSK_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=10
PDF_RENDER_DPI=144
AUTO_CREATE_SCHEMA=true
BOOTSTRAP_ADMIN_EMAIL=admin@medikiosk.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_DEMO_PASSWORD

AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_AZURE_STORAGE_CONNECTION_STRING
AZURE_BLOB_CONTAINER=medikiosk-documents
AZURE_BLOB_CREATE_CONTAINER=false
LLM_BASE_URL=https://YOUR_OPENAI_COMPATIBLE_PROVIDER/v1
LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
LLM_MODEL=gpt-5.6-luna
LLM_TIMEOUT_SECONDS=30
# STT uses Azure's deployment-style audio API, not LLM_BASE_URL's `/openai/v1` route.
AZURE_OPENAI_ENDPOINT=https://YOUR_AZURE_OPENAI_RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-10-21
# Hackathon adapter modes: disabled, mock (synthetic fixture output), or openai_compatible.
SPEECH_ADAPTER_MODE=disabled
OCR_ADAPTER_MODE=disabled
# Speech reuses LLM_API_KEY, but uses AsyncAzureOpenAI and the endpoint above for STT.
# TTS remains on the OpenAI-compatible LLM_BASE_URL route until it is separately migrated.
# OCR image extraction uses the same direct AsyncOpenAI configuration and LLM_MODEL (gpt-5.6-luna).
AZURE_OPENAI_STT_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_TTS_VOICE=alloy
