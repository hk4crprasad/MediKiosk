# Add these values to backend/.env. Do not commit a real connection string.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=REPLACE_ME;AccountKey=REPLACE_ME;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=medikiosk-documents
# false in Azure: create the private container through IaC/portal before deployment.
AZURE_BLOB_CREATE_CONTAINER=false
