{
  "info": {
    "_postman_id": "5f47b731-cd39-4f93-979f-836bdf04e29c",
    "name": "MediKiosk API — Planned Contract",
    "description": "Living FastAPI contract collection. No endpoint is marked verified by this collection alone. The user must execute each request in Postman and explicitly accept its result before the related backend slice advances. Never export real credentials or patient data with this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_prefix", "value": "/api/v1", "type": "string" },
    { "key": "staff_access_token", "value": "SET_IN_POSTMAN_ENVIRONMENT", "type": "string" },
    { "key": "kiosk_session_token", "value": "SET_IN_POSTMAN_ENVIRONMENT", "type": "string" },
    { "key": "encounter_id", "value": "SET_AFTER_CREATE", "type": "string" },
    { "key": "document_id", "value": "SET_AFTER_UPLOAD", "type": "string" },
    { "key": "red_flag_id", "value": "SET_AFTER_RULE_TRIGGER", "type": "string" },
    { "key": "consent_id", "value": "SET_AFTER_CONSENT", "type": "string" },
    { "key": "export_id", "value": "SET_AFTER_EXPORT", "type": "string" }
  ],
  "item": [
    {
      "name": "B0 — Foundation (user test gate H-01 to H-02)",
      "item": [
        {
          "name": "H-01 GET /health",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/health", "description": "User check: process liveness only; must not call external AI providers." },
          "response": []
        },
        {
          "name": "H-02 GET /ready",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/ready", "description": "User check: readiness reports database/migration availability without disclosing secrets." },
          "response": []
        }
      ]
    },
    {
      "name": "B1 — Auth, encounter, consent (user test gate A/E/C)",
      "item": [
        {
          "name": "A-01 POST /auth/login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@medikiosk.local\",\n  \"password\": \"SET_IN_POSTMAN_ENVIRONMENT\"\n}" }, "url": "{{base_url}}{{api_prefix}}/auth/login", "description": "User records status and request ID; set the returned staff token manually in the Postman environment." },
          "response": []
        },
        {
          "name": "A-03 GET /auth/me",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }], "url": "{{base_url}}{{api_prefix}}/auth/me", "description": "User verifies only expected identity and role fields are exposed." },
          "response": []
        },
        {
          "name": "A-04 POST /admin/users — provision test role",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"triage.synthetic@medikiosk.local\",\n  \"password\": \"SET_A_SYNTHETIC_TEST_PASSWORD\",\n  \"role\": \"triage\"\n}" }, "url": "{{base_url}}{{api_prefix}}/admin/users", "description": "User verifies admin-only access and records duplicate-email/unauthorised behavior separately. Do not use a real user or password." },
          "response": []
        },
        {
          "name": "E-01 POST /encounters",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patient\": {\n    \"display_name\": \"Synthetic Patient A\",\n    \"birth_year\": 1980,\n    \"sex\": \"female\",\n    \"preferred_language\": \"en\"\n  },\n  \"mode\": \"kiosk\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters", "description": "Planned sample only. User sets encounter_id and kiosk_session_token manually after examining the response." },
          "response": []
        },
        {
          "name": "E-02 GET /encounters/{encounter_id}",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}", "description": "User tests permitted kiosk access and separately records a denied cross-encounter attempt." },
          "response": []
        },
        {
          "name": "C-01 POST /encounters/{encounter_id}/consents",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"consent_type\": \"clinical_intake\",\n  \"version\": \"v1\",\n  \"language\": \"en\",\n  \"granted\": true\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/consents", "description": "User verifies immutable, versioned consent receipt; set consent_id manually from the response. Do not use real consent text until approved." },
          "response": []
        },
        {
          "name": "C-02 GET /encounters/{encounter_id}/consents",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/consents", "description": "User verifies consent history/current state and kiosk authorisation behavior." },
          "response": []
        },
        {
          "name": "C-03 POST /consents/{consent_id}/revocations",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/consents/{{consent_id}}/revocations", "description": "Run only on a separate synthetic encounter after the intake path test. User verifies the receipt remains visible, has revoked_at, and further intake is blocked." },
          "response": []
        },
        {
          "name": "A-02 POST /auth/logout — run last",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }], "url": "{{base_url}}{{api_prefix}}/auth/logout", "description": "Run last. User then re-runs A-03 with the same token and records the expected unauthorised result, then logs in again for later slices." },
          "response": []
        }
      ]
    },
    {
      "name": "B2 — Controlled intake (user test gate I-01 to I-04)",
      "item": [
        {
          "name": "I-01 GET /intake/next-question",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/next-question", "description": "User verifies that this first requires consent, then returns the next configured question without AI-generated content." },
          "response": []
        },
        {
          "name": "I-02 POST /intake/responses — chief complaint",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"chief_complaint\",\n  \"value\": \"chest_discomfort\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "User repeats this request only as the pathway permits. Record the fact ID and status; do not infer test success from this collection." },
          "response": []
        },
        {
          "name": "I-02 POST /intake/responses — onset/duration",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"onset_duration\",\n  \"value\": \"Started 30 minutes ago\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Run only after I-01 confirms onset_duration is next. Record status, response_id, and created fact." },
          "response": []
        },
        {
          "name": "I-02 POST /intake/responses — breathlessness",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"breathlessness\",\n  \"value\": \"yes\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "This is the positive red-flag fixture. B2 only verifies sequence/fact persistence; B3 verifies the triage result." },
          "response": []
        },
        {
          "name": "I-02 POST /intake/responses — sweating",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"sweating\",\n  \"value\": \"no\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Optional configured question. Run it because it is currently the exact next question in the chest-discomfort path." },
          "response": []
        },
        {
          "name": "I-02 POST /intake/responses — allergies",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"allergies\",\n  \"value\": \"No known allergies\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Required history question. Use synthetic data only." },
          "response": []
        },
        {
          "name": "I-02 POST /intake/responses — current medications",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"current_medications\",\n  \"value\": \"No regular medicines\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Required history question. I-01 should return null after this response for the configured pathway." },
          "response": []
        },
        {
          "name": "I-03 GET /facts",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/facts", "description": "User verifies fact source, value, and verification status match the submitted answer." },
          "response": []
        },
        {
          "name": "I-04 POST /submit",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/submit", "description": "User first verifies a missing-field rejection, completes all required questions through I-01/I-02, then verifies final submission." },
          "response": []
        }
      ]
    },
    {
      "name": "B3 — Safety and clinician review (user test gate T/R)",
      "item": [
        {
          "name": "T-01 GET /triage/queue — positive safety fixture",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }], "url": "{{base_url}}{{api_prefix}}/triage/queue", "description": "Prerequisite: use a fresh synthetic encounter and submit chest_discomfort followed by breathlessness=yes through B2. User verifies exactly one urgent-review item for the encounter, rule_id chest-discomfort-with-breathlessness, non-diagnostic wording, and evidence fact IDs." },
          "response": []
        },
        {
          "name": "T-02 POST /red-flags/{red_flag_id}/acknowledgements",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"note\": \"Synthetic demo acknowledgement\"\n}" }, "url": "{{base_url}}{{api_prefix}}/red-flags/{{red_flag_id}}/acknowledgements", "description": "Set red_flag_id from T-01. User verifies acknowledged_by/acknowledged_at are populated while active, rule_id, severity, reason, and evidence_fact_ids remain intact. Repeat is idempotent." },
          "response": []
        },
        {
          "name": "R-01 GET /clinician/encounters/{encounter_id}",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }], "url": "{{base_url}}{{api_prefix}}/clinician/encounters/{{encounter_id}}", "description": "User verifies staff-only access and a coherent clinician view: encounter state, structured facts, active red flag with evidence, documents, and latest summary. Kiosk token must be denied." },
          "response": []
        }
      ]
    },
    {
      "name": "B4 — Documents (user test gate D-01 to D-03)",
      "item": [
        {
          "name": "D-01 POST /documents upload",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "document_type", "value": "lab_report", "type": "text" }, { "key": "file", "type": "file", "src": "SET_A_SYNTHETIC_PDF_OR_IMAGE" }] }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/documents", "description": "User supplies a valid synthetic PDF/JPEG/PNG smaller than the configured limit and with matching file content. The file must land in the configured private Azure Blob container; record document_id manually. Also verify missing/revoked consent and mismatched MIME/content are rejected." },
          "response": []
        },
        {
          "name": "D-02 GET /encounter documents",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/documents", "description": "User verifies only this encounter's document metadata and processing state are listed." },
          "response": []
        },
        {
          "name": "D-03 GET /documents/{document_id}",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/documents/{{document_id}}", "description": "User verifies authorised metadata retrieval and separately checks unauthorised access is denied." },
          "response": []
        },
        {
          "name": "D-04 GET /documents/{document_id}/content",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/documents/{{document_id}}/content", "description": "User verifies the authorised original synthetic source file streams from private Azure Blob Storage with its declared content type. A different encounter token must be denied; missing stored content must return a safe not-found response." },
          "response": []
        }
      ]
    },
    {
      "name": "B5 — Summary and physician verification (user test gate S-01 to S-04)",
      "item": [
        {
          "name": "S-01 POST /summary/generations",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/summary/generations", "description": "Server prerequisite: LLM_BASE_URL and LLM_API_KEY are present only in backend/.env; never put them in Postman. Expected configured-provider result: source=openai_compatible, prompt_version=openai-compatible-summary-v1, and gpt-5.6-luna receives no temperature/max_tokens parameters. Expected degraded result: source=template_fallback. User checks that uncaptured facts are Not captured rather than invented." },
          "response": []
        },
        {
          "name": "S-02 GET /summary",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/summary", "description": "User verifies the current draft and role restrictions." },
          "response": []
        },
        {
          "name": "S-03 PATCH /summary",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"text\": \"Clinician-edited synthetic summary.\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/summary", "description": "User verifies physician-only edit and persistence through S-02." },
          "response": []
        },
        {
          "name": "S-04 POST /summary/verifications",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{staff_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"decision\": \"accept\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/summary/verifications", "description": "User verifies explicit accept/reject behavior and encounter verification state." },
          "response": []
        }
      ]
    },
    {
      "name": "AYUSH — Dashavidha intake (user test gate AYU-01 to AYU-05)",
      "item": [
        {
          "name": "AYU-01 POST /encounters — create AYUSH encounter",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"patient\": {\n    \"display_name\": \"Synthetic AYUSH Patient\",\n    \"birth_year\": 1988,\n    \"sex\": \"female\",\n    \"preferred_language\": \"en\"\n  },\n  \"mode\": \"kiosk\",\n  \"pathway_version\": \"ayush-dashavidha-v1\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters", "description": "User confirms the returned pathway_version is ayush-dashavidha-v1, then manually replaces encounter_id and kiosk_session_token with this response's values. Also submit an unknown pathway_version separately and confirm a safe 422 response." },
          "response": []
        },
        {
          "name": "AYU-02 POST /consents — grant AYUSH intake consent",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"consent_type\": \"clinical_intake\",\n  \"version\": \"ayush-v1\",\n  \"language\": \"en\",\n  \"granted\": true\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/consents", "description": "User confirms active consent is required before the AYUSH questions are available." },
          "response": []
        },
        {
          "name": "AYU-03 GET /intake/next-question — Dashavidha start",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }], "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/next-question", "description": "User verifies the first configured question is ayush_prakriti and that the response identifies ayush-dashavidha-v1. Run before every response if checking the enforced sequence." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Prakriti",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_prakriti\",\n  \"value\": \"Patient-reported Vata-Pitta tendency\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Synthetic, patient-reported example only; not a diagnosis." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Vikriti",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_vikriti\",\n  \"value\": \"Patient reports disturbed sleep for two days\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Required Dashavidha context, saved as a patient-confirmed clinical fact." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Sara",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_sara\",\n  \"value\": \"Not sure\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Optional patient-reported field retained for the configured sequence." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Samhanana",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_samhanana\",\n  \"value\": \"Average build\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Synthetic patient-reported context only." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Pramana",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_pramana\",\n  \"value\": \"No measurements provided\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Synthetic patient-reported context only." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Satmya",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_satmya\",\n  \"value\": \"Regular home-cooked meals suit patient\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Synthetic patient-reported context only." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Sattva",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_sattva\",\n  \"value\": \"Patient reports moderate stress tolerance\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Synthetic patient-reported context only." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Ahara Shakti",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{kiosk_session_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"question_key\": \"ayush_ahara_shakti\",\n  \"value\": \"Usually normal appetite\",\n  \"input_mode\": \"touch\",\n  \"language\": \"en\"\n}" }, "url": "{{base_url}}{{api_prefix}}/encounters/{{encounter_id}}/intake/responses", "description": "Synthetic patient-reported context only." },
          "response": []
        },
        {
          "name": "AYU-04 POST /intake/responses — Vyayama Shakti",
